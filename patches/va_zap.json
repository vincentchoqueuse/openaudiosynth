{
  "version": 2,
  "engine": "va",
  "name": "va_zap",
  "description": "IDM blip / zap: saw + fifth with a falling pitch sweep, resonant filter, random stereo position per hit, thrown into a tempo-synced ping-pong echo (3/16 at 92 bpm).",
  "osc1": {"waveform": "saw"},
  "osc2": {"waveform": "pulse", "semitone": 7, "level": 0.5},
  "filter": {"cutoff": 2800, "resonance": 6, "envelope_amount": 0, "keytrack": 0},
  "amp": {"attack": 0.0005, "decay": 0.09, "sustain": 0, "release": 0.04, "velocity": 0.6},
  "output": {"volume": 12.0},
  "voice": {"drift": 0, "pan_spread": 1},
  "pitch_env": {"amount": -18, "decay": 0.05},
  "fx": {"delay": {"mix": 0.35, "time": 0.489, "feedback": 0.5, "tone": 4500, "wow": 0.15, "pingpong": "on"}},
  "audition": {"notes": "C6 - - E6 - - - G5 - C6 - - - - A5 -", "bpm": 92, "step": 0.25, "gate": 0.5}
}
