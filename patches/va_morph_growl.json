{
  "version": 2,
  "engine": "va",
  "name": "va_morph_growl",
  "description": "Talking bass: saw + sub square through the growl filter table, its mouth opened by an eighth-note LFO and by how hard the note hits, the filter's own feedback grunting under it.",
  "osc1": {"waveform": "saw", "unison_voices": 3, "unison_detune": 12, "unison_blend": 0.6},
  "osc2": {"waveform": "pulse", "octave": -1, "pulse_width": 0.5, "level": 0.6},
  "filter": {
    "type": "growl",
    "cutoff": 420,
    "resonance": 3,
    "envelope_amount": 1.5,
    "keytrack": 0.5,
    "velocity": 1,
    "character": 0.45,
    "morph": 0.15,
    "feedback": 0.35,
    "follow": 0.5
  },
  "amp": {"attack": 0.002, "decay": 0.3, "sustain": 0.8, "release": 0.06},
  "filter_env": {"attack": 0.001, "decay": 0.2, "sustain": 0.3},
  "output": {"volume": 10.5},
  "voice": {"drift": 2, "pan_spread": 0},
  "mlfo1": {"sync": "1/8", "waveform": "tri"},
  "route1": {"source": "mlfo1", "destination": "filter.morph", "amount": 0.35},
  "macros": [
    {"name": "Mouth", "value": 0.15, "targets": [{"param": "filter.morph", "from": 0, "to": 1}]},
    {
      "name": "Grunt",
      "value": 0.4,
      "targets": [
        {"param": "filter.feedback", "from": 0, "to": 0.9},
        {"param": "filter.character", "from": 0.2, "to": 0.8}
      ]
    },
    {"name": "Push", "value": 0.5, "targets": [{"param": "filter.follow", "from": 0, "to": 1}]},
    {"name": "Cutoff", "value": 0.5, "targets": [{"param": "filter.cutoff", "from": 150, "to": 1200}]}
  ],
  "audition": {"notes": "E1! E1 E2 E1 G1! E1 D2 E1 E1! B1 E1 A1 E1 E2! G1 D1", "bpm": 140, "gate": 0.7}
}
