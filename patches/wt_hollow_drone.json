{
  "version": 2,
  "engine": "wt",
  "name": "wt_hollow_drone",
  "description": "Hollow glacial drone: a resonant table mirror-warped with a faint vowel an octave up, through a negative (hollow, odd-harmonic) comb; each note's comb glides up and down about an octave and a half over ~20 s on its own MSEG, timbre breathing on its own LFO, notes scattered in the stereo field. Very slow, very cold, very deep.",
  "osc1": {
    "wavetable": "resonant",
    "position": 0.5,
    "warp_mode": "mirror",
    "warp": 0.3,
    "level": 0.6,
    "unison_voices": 4,
    "unison_detune": 8
  },
  "osc2": {"wavetable": "vowel", "position": 0.6, "level": 0.25, "octave": 1},
  "sub": {"level": 0.4},
  "noise": {"level": 0.08},
  "filter": {"type": "comb_neg", "cutoff": 392.0, "resonance": 0.9, "drive": 0.25, "keytrack": 1.0},
  "amp": {"attack": 4.0, "decay": 2.0, "sustain": 1.0, "release": 10.0, "velocity": 0.3},
  "output": {"volume": 14.5},
  "voice": {"pan_spread": 0.9},
  "fx": {
    "delay": {"mix": 0.18, "feedback": 0.6, "tone": 4500, "pingpong": "on", "sync": "1/4d"},
    "reverb": {"mix": 0.55, "decay": 0.95, "damping": 7000, "predelay": 0.08}
  },
  "tempo": {"bpm": 64},
  "part": {"level": 3},
  "vmseg": {
    "mode": "loop_free",
    "points": 3,
    "sustain": "none",
    "loop_start": "1",
    "loop_end": "3",
    "point1": {"time": 0, "level": 0.0, "curve": 0},
    "point2": {"time": 9.0, "level": 1.0, "curve": -0.5},
    "point3": {"time": 11.0, "level": 0.0, "curve": 0.5}
  },
  "vlfo": {"rate": 0.045, "waveform": "tri"},
  "vroute1": {"source": "vmseg", "destination": "brightness", "amount": 0.12},
  "vroute2": {"source": "vlfo", "destination": "timbre", "amount": 0.3},
  "vroute3": {"source": "random", "destination": "pan", "amount": 0.6}
}
