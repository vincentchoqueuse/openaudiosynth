{
  "version": 2,
  "engine": "micro",
  "name": "micro_white_cut",
  "description": "A rectangle of white noise: full level from the first sample, 20 ms, cut on the sample. No filter, no fade.",
  "osc1": {"level": -60},
  "micro": {
    "env_mode": "one_shot",
    "hold": 0.02,
    "decay_curve": 0,
    "noise_type": "white",
    "noise_filter": "off",
    "noise_env": "amp"
  },
  "amp": {"attack": 2e-05, "decay": 0.0005, "sustain": 0, "velocity": 0.6},
  "output": {"volume": 11.1},
  "noise": {"level": -4},
  "tempo": {"bpm": 120},
  "clip": {
    "bpm": 120,
    "length": 4,
    "loop": true,
    "grid": "1/16",
    "notes": [
      {"pitch": 60, "start": 1, "length": 0.1, "velocity": 100},
      {"pitch": 60, "start": 3, "length": 0.1, "velocity": 100},
      {"pitch": 60, "start": 3.75, "length": 0.1, "velocity": 100}
    ]
  }
}
