{
  "version": 2,
  "engine": "va",
  "name": "va_hazy_tape",
  "description": "Hazy tape pad: two detuned saws whose oscillators wander on their own (tolerance, slow drift, phase jitter), a Wiener wobble on the pitch like old tape, dark filter, chorus, worn tape delay; slow minor-ninth chords with a faint line on top.",
  "osc1": {"waveform": "saw", "octave": 0, "semitone": 0, "pulse_width": 0.5, "level": 0.8, "sync": "off"},
  "osc2": {"waveform": "saw", "octave": 0, "semitone": 0, "detune": 7, "pulse_width": 0.5, "level": 0.8},
  "noise": {"level": 0.04},
  "filter": {
    "type": "ladder",
    "cutoff": 1500,
    "resonance": 0.8991,
    "envelope_amount": 0.7,
    "keytrack": 0.3,
    "velocity": 1.0,
    "character": 0.15,
    "oversample": "1x"
  },
  "amp": {"attack": 0.35, "decay": 2.0, "sustain": 0.85, "release": 2.6, "velocity": 0.5},
  "filter_env": {"attack": 0.8, "decay": 3.0, "sustain": 0.4, "release": 2.5},
  "lfo": {
    "rate": 5,
    "waveform": "tri",
    "to_pitch": 0.0,
    "to_cutoff": 0.0,
    "to_pulse_width": 0.0,
    "wheel_vibrato": 0.2
  },
  "output": {"volume": 2.4},
  "voice": {
    "drift": 7,
    "pan_spread": 0.7,
    "bend_range": 2,
    "glide": 0,
    "tolerance": 4,
    "drift_time": 7,
    "jitter": 0.5
  },
  "fx": {
    "chorus": {"mode": "I", "mix": 0.4},
    "delay": {"mix": 0.25, "time": 0.62, "feedback": 0.42, "tone": 2000, "drive": 0.4, "wow": 0.6},
    "reverb": {"mix": 0.32, "decay": 0.88, "damping": 3200}
  },
  "mlfo1": {"rate": 0.06, "waveform": "wiener"},
  "route1": {"source": "mlfo1", "destination": "filter.cutoff", "amount": 0.06},
  "vlfo": {"rate": 0.3, "waveform": "wiener"},
  "vroute1": {"source": "vlfo", "destination": "pitch", "amount": 0.012}
}
