{
  "version": 2,
  "engine": "wt",
  "name": "wt_hyper_lead",
  "description": "Wide trance-style lead: 8-voice unison saw frames on both oscillators (B an octave up), lp12 opened by env2, slow LFO drifting the position for shimmer, glide in legato.",
  "osc1": {"wavetable": "basic", "position": 0.667, "level": 0.8, "unison_voices": 8, "unison_detune": 22},
  "osc2": {
    "wavetable": "basic",
    "position": 0.667,
    "level": 0.35,
    "octave": 1,
    "unison_voices": 4,
    "unison_detune": 14
  },
  "filter": {"type": "lp12", "cutoff": 2500, "resonance": 0.15},
  "amp": {"attack": 0.004, "release": 0.35},
  "env2": {"attack": 0.005, "decay": 0.6, "sustain": 0.3},
  "lfo1": {"rate": 0.3, "retrigger": "off"},
  "mod": {
    "slot1": {"source": "env2", "destination": "cutoff", "amount": 0.35},
    "slot2": {"source": "lfo1", "destination": "a_position", "amount": 0.04}
  },
  "voice": {"mode": "legato", "glide": 0.06, "pan_spread": 0},
  "output": {"volume": 12},
  "fx": {"chorus": {"mode": "I+II", "mix": 0.3}, "delay": {"mix": 0.2, "time": 0.41}, "reverb": {"mix": 0.2}},
  "audition": {
    "notes": "A4 _ C5 E5 _ D5 C5 _ B4 _ _ G4 A4 _ _ _ - -",
    "bpm": 128,
    "step": 0.5,
    "humanize_velocity": 6,
    "humanize_ms": 4
  }
}
