    "proc2": {"type": "sub", "p1": 0.3, "p2": 0.8, "mix": 0.5},
    "gen1": {
      "type": "tone",
      "pitch": -17,
      "track": "off",
      "a": 0.6,
      "b": 0.4,
      "fm": 0.5,
      "ring": 0,
      "life": "steady",
      "life_rate": 2.0,
      "life_shape": 0.5,
      "level": 0.7,
      "pan": -0.4
    },
    "gen2": {
      "type": "logistic",
      "pitch": -9,
      "track": "off",
      "a": 0.8,
      "b": 0.2,
      "fm": 0.6,
      "ring": 0.3,
      "life": "steady",
      "life_rate": 2.0,
      "life_shape": 0.5,
      "level": 0.7,
      "pan": 0.4
    },
    "gen3": {
