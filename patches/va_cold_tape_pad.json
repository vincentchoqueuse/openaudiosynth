  "osc2": {"waveform": "saw", "detune": 0, "level": 0.9},
  "filter": {"cutoff": 620, "resonance": 0.9, "envelope_amount": 0.6, "keytrack": 0.3, "velocity": 0},
  "amp": {"attack": 3.5, "decay": 3, "sustain": 1, "release": 6, "velocity": 0.2},
  "filter_env": {"attack": 4, "decay": 8, "sustain": 0.5, "release": 6},
  "lfo": {"rate": 0.025, "waveform": "tri", "to_cutoff": 0.5},
  "output": {"volume": 2.8},
  "voice": {"drift": 6, "pan_spread": 1.0},
  "motion": {
    "detune1": {"rate": 0.13, "depth": 9},
    "spread": 1.0,
    "meta_rate": 1.0,
    "meta_depth": 0.5,
    "detune2": {"rate": 0.09, "depth": 7},
    "detune3": {"rate": 0.05, "depth": 14}
  },
  "filter2": {"type": "hp", "cutoff": 110, "resonance": 0},
  "fx": {"chorus": {"mode": "I", "mix": 0.3}}
