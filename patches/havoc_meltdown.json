      "b": 0.2,
      "fm": 0.4,
      "ring": 0,
      "life": "steady",
      "life_rate": 2.0,
      "life_shape": 0.5,
      "level": 0.6,
      "pan": 0.0
    },
    "gen4": {
      "type": "byte",
      "pitch": -28,
      "track": "off",
      "a": 0.6,
      "b": 0.4,
      "fm": 0.5,
      "ring": 0,
      "life": "bursts",
      "life_rate": 4,
      "life_shape": 0.5,
      "level": 0.5,
      "pan": 0.0
    }
  },
  "fx": {"reverb": {"mix": 0.2, "decay": 0.85, "damping": 3000, "predelay": 0.01}},
  "macros": [
    {
      "name": "Rot",
      "value": 0,
      "targets": [
        {"param": "havoc.gen1.rot", "from": 0, "to": 0.7},
        {"param": "havoc.gen2.rot", "from": 0, "to": 0.7},
        {"param": "havoc.gen3.rot", "from": 0, "to": 0.7},
        {"param": "havoc.gen4.rot", "from": 0, "to": 0.7}
      ]
    },
    {
      "name": "Motion",
      "value": 0,
      "targets": [
        {"param": "havoc.gen1.lfo_a", "from": 0, "to": 0.5},
        {"param": "havoc.gen1.lfo_b", "from": 0, "to": 0.5},
        {"param": "havoc.gen2.lfo_a", "from": 0, "to": 0.5},
        {"param": "havoc.gen2.lfo_b", "from": 0, "to": 0.5},
        {"param": "havoc.gen3.lfo_a", "from": 0, "to": 0.5},
        {"param": "havoc.gen3.lfo_b", "from": 0, "to": 0.5},
        {"param": "havoc.gen4.lfo_a", "from": 0, "to": 0.5},
        {"param": "havoc.gen4.lfo_b", "from": 0, "to": 0.5}
