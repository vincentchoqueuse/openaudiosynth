    "hardness": 0.75,
    "noise": 0.06,
    "variation": 3,
    "pan_spread": 0.5,
    "delay_mix": 0.3,
    "delay_time": 0.643,
    "delay_pingpong": "on",
    "delay_feedback": 0.45,
    "delay_tone": 3000,
    "delay_wow": 0.3
  },
  "audition": {
    "notes": "D5 A4 E5 F#5 - A5 F#5 E5 D5 - A4 B4 - E5 - -",
    "bpm": 70,
    "step": 0.5
  }
