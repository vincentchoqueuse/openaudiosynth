{
  "version": 2,
  "engine": "drone",
  "name": "drone_pt_saint_mathieu",
  "description": "Pointe Saint-Mathieu at dusk: the lighthouse over the abbey ruins and the cliffs, the sea's breath below. D Dorian (a minor third and a bright sixth): the whole drone swells gently in and out like the sea, soft wide air without whistle, and the sparkles turn like the beam.",
  "drone": {
    "temperature": 0.45,
    "density": 0.6,
    "motion": 0.5,
    "depth": 0.35,
    "brightness": 0.5,
    "sparkle": 0.25,
    "width": 0.85,
    "air_reso": 0.3
  },
  "amp": {"attack": 8, "release": 14},
  "output": {"volume": -9.4},
  "fx": {
    "delay": {"mix": 0.12, "time": 1.2, "feedback": 0.4, "tone": 2500},
    "reverb": {"mix": 0.55, "decay": 0.95, "damping": 4500, "predelay": 0.05}
  },
  "mlfo1": {"rate": 0.04, "waveform": "sine"},
  "mlfo2": {"rate": 0.1, "waveform": "wiener"},
  "route1": {"source": "mlfo1", "destination": "output.volume", "amount": 0.018},
  "route2": {"source": "mlfo2", "destination": "output.volume", "amount": 0.012},
  "vlfo": {"rate": 0.15, "waveform": "wiener"},
  "vroute1": {"source": "vlfo", "destination": "pitch", "amount": 0.004}
}
