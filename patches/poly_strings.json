{
  "version": 1,
  "engine": "poly",
  "name": "poly_strings",
  "description": "Lush string-machine-like pad: pulse waves with slow LFO PWM, slow attack and release, chorus ensemble.",
  "params": {
    "osca_saw": "off",
    "osca_pulse": "on",
    "oscb_saw": "off",
    "oscb_pulse": "on",
    "oscb_fine": 6,
    "cutoff": 2400,
    "fenv_amount": 0.5,
    "amp_attack": 0.6,
    "amp_release": 1.5,
    "lfo_rate": 0.6,
    "lfo_amount": 0.8,
    "lfo_pwm": 0.35,
    "lfo_pitch": 0,
    "pan_spread": 0.8,
    "chorus_mode": "ensemble",
    "chorus_mix": 0.5,
    "reverb_mix": 0.3
  },
  "audition": {
    "notes": "D3+A3+F4 _ _ _ C3+G3+E4 _ _ _",
    "bpm": 70,
    "step": 1
  }
}
