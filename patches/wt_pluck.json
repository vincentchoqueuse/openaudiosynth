{
  "version": 2,
  "engine": "wt",
  "name": "wt_pluck",
  "description": "Glassy pluck: harmonics table whose position (number of harmonics) falls with a short env2, plus a quick filter decay; velocity adds brightness.",
  "osc1": {"wavetable": "harmonics", "position": 0.15, "level": 0.9, "unison_voices": 2, "unison_detune": 6},
  "filter": {"type": "lp12", "cutoff": 1800, "resonance": 0.2, "keytrack": 0.6},
  "amp": {"attack": 0.001, "decay": 0.6, "sustain": 0.0, "release": 0.4},
  "env2": {"attack": 0.001, "decay": 0.25, "sustain": 0.0, "release": 0.2},
  "mod": {
    "slot1": {"source": "env2", "destination": "a_position", "amount": 0.7},
    "slot2": {"source": "env2", "destination": "cutoff", "amount": 0.4, "via": "velocity"}
  },
  "output": {"volume": 14.6},
  "voice": {"pan_spread": 0.5},
  "fx": {"delay": {"mix": 0.25, "time": 0.33, "pingpong": 1}, "reverb": {"mix": 0.2}},
  "audition": {
    "notes": "C5 G4 E5 C5 B4 G4 D5 B4 A4 E4 C5 A4 G4 D4 B4 G4",
    "bpm": 118,
    "step": 0.25,
    "humanize_velocity": 6,
    "humanize_ms": 4
  }
}
