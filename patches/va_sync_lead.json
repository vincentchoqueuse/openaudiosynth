{
  "version": 2,
  "engine": "va",
  "name": "va_sync_lead",
  "description": "The sync lead: osc 1 hard-synced to osc 2, the filter envelope poly-modulates osc 1 frequency, so each note screams down from bright to warm.",
  "osc1": {
    "waveform": "saw",
    "octave": 1,
    "semitone": 0,
    "pulse_width": 0.5,
    "level": 0.8,
    "unison_voices": 5,
    "unison_detune": 10,
    "unison_blend": 1.0,
    "unison_width": 0.6,
    "sync": "on"
  },
  "osc2": {
    "waveform": "saw",
    "octave": 0,
    "semitone": 0,
    "detune": 7,
    "pulse_width": 0.5,
    "level": 0,
    "unison_voices": 5,
    "unison_detune": 10,
    "unison_blend": 1.0,
    "unison_width": 0.6
  },
  "noise": {"level": 0},
  "filter": {
    "type": "ladder",
    "cutoff": 3000,
    "resonance": 1.3296,
    "envelope_amount": 1.0,
    "keytrack": 0.5,
    "velocity": 1.0,
    "character": 0.15,
    "oversample": "1x"
  },
  "amp": {"attack": 0.005, "decay": 0.4, "sustain": 1.0, "release": 0.4, "velocity": 0.5},
  "filter_env": {"attack": 0.005, "decay": 0.5, "sustain": 0.0, "release": 0.4},
  "lfo": {
    "rate": 5,
    "waveform": "tri",
    "to_pitch": 0.0,
    "to_cutoff": 0.0,
    "to_pulse_width": 0.0,
    "wheel_vibrato": 0.2
  },
  "output": {"volume": 13.4},
  "voice": {
    "drift": 4,
    "pan_spread": 0.4,
    "bend_range": 2,
    "mode": "legato",
    "glide": 0.04,
    "tolerance": 2,
    "drift_time": 3,
    "jitter": 0.2
  },
  "polymod": {"source_osc2": 0, "source_filter_env": 0.8, "target": "pitch"},
  "fx": {"delay": {"mix": 0.25, "time": 0.4}},
  "audition": {"notes": "E4 _ _ G4 A4 _ _ _ B4 _ A4 _ G4 _ E4 _", "bpm": 112, "step": 0.5, "gate": 0.9}
