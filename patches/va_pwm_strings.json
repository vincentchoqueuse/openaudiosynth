{
  "version": 2,
  "engine": "va",
  "name": "va_pwm_strings",
  "description": "String-ensemble-like: two pulse waves with slow LFO pulse-width modulation, soft attack.",
  "osc1": {"waveform": "pulse"},
  "osc2": {"waveform": "pulse", "detune": 6, "level": 0.8},
  "filter": {"cutoff": 2200, "resonance": 0.8, "envelope_amount": 0.5, "keytrack": 0.7},
  "amp": {"attack": 0.12, "decay": 0.5, "sustain": 0.85, "release": 0.7},
  "lfo": {"rate": 0.7, "to_pulse_width": 0.35},
  "output": {"volume": 1.2},
  "voice": {"pan_spread": 0.6}
}
