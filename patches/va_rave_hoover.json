{
  "version": 2,
  "engine": "va",
  "name": "va_rave_hoover",
  "description": "Early-90s rave hoover: a wide unison of 7 detuned saws over a pulse an octave down with moving width, the pitch swooping down onto every note, notes gliding into each other, a heavy chorus.",
  "osc1": {"waveform": "saw", "unison_voices": 7, "unison_detune": 45, "unison_blend": 0.85, "unison_width": 0.7},
  "osc2": {"waveform": "pulse", "octave": -1, "pulse_width": 0.3, "level": 0.7},
  "filter": {"cutoff": 5000, "resonance": 1.0, "envelope_amount": 0.8},
  "amp": {"attack": 0.005, "decay": 0.5, "sustain": 0.9, "release": 0.35},
  "filter_env": {"decay": 0.6, "sustain": 0.6},
  "lfo": {"rate": 3.5, "to_pulse_width": 0.25},
  "output": {"volume": 6.7},
  "voice": {"drift": 4, "mode": "legato", "glide": 0.08},
  "osc": {"unison": {"motion": 4}},
  "pitch_env": {"amount": 7, "decay": 0.18},
  "fx": {"chorus": {"mode": "I+II", "mix": 0.6}, "reverb": {"mix": 0.18, "decay": 0.6}}
}
