      "patch": "patches/ambient_saw_pad.json",
      "step": 4,
      "repeat": 2,
      "notes": "D3+A3+E4+F4 _ _ _ _ _ Bb2+F3+A3+D4 _ _ _ _ _",
      "gain_db": 0,
      "reverb_send": 0.55
    },
    {
      "patch": "patches/ambient_saw_low.json",
      "step": 4,
      "notes": "D2+A2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _",
      "gain_db": -3,
      "reverb_send": 0.3
    },
    {
      "patch": "patches/ambient_sub.json",
      "step": 4,
      "notes": "- - D1 _ _ - - - Bb1 _ _ - - - D1 _ _ _ - - Bb1 _ _ -",
      "gain_db": 1,
      "reverb_send": 0.08
    },
    {
      "patch": "patches/ambient_bell.json",
      "step": 1,
      "start_step": 16,
