  "amp": {"attack": 0.004, "decay": 0.3, "sustain": 1.0, "release": 0.1},
  "voice": {"mode": "legato", "glide": 0.06, "pan_spread": 0.0},
  "output": {"volume": 16.4},
  "fx": {
