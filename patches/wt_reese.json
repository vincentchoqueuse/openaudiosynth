{
  "version": 2,
  "engine": "wt",
  "name": "wt_reese",
  "description": "Dark rolling reese: two saw-frame oscillators detuned against each other with unison, B a few cents off, low-passed; the slow beating is the sound.",
  "osc1": {"wavetable": "basic", "position": 0.667, "level": 0.7, "unison_voices": 4, "unison_detune": 12},
  "osc2": {
    "wavetable": "basic",
    "position": 0.75,
    "level": 0.6,
    "detune": -14,
    "unison_voices": 4,
    "unison_detune": 18
  },
  "sub": {"level": 0.35},
  "filter": {"type": "lp24", "cutoff": 700, "resonance": 0.2, "drive": 0.25, "keytrack": 0.2},
  "amp": {"attack": 0.01, "release": 0.25},
  "lfo1": {"rate": 0.15, "retrigger": "off"},
  "mod": {
    "slot1": {"source": "lfo1", "destination": "cutoff", "amount": 0.15},
    "slot2": {"source": "lfo1", "destination": "b_position", "amount": 0.1}
  },
  "voice": {"mode": "mono"},
  "output": {"volume": 15.3}
}
