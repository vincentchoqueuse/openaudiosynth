{
  "version": 2,
  "engine": "va",
  "name": "va_swarm_pad",
  "description": "Swarm pad: osc 1 = a unison of 7 saws, osc 2 = 7 more one octave down (14 saws per note), spread wide across the stereo field. Each saw has its own desynchronized motion LFO, and the per-voice detune LFOs 2-4 plus the LFO-of-LFO move the whole swarm. Slow swell, soft low-pass, meant for a big reverb.",
  "osc1": {"waveform": "saw", "unison_voices": 7, "unison_detune": 22, "unison_blend": 0.75, "unison_width": 0.8},
  "osc2": {
    "waveform": "saw",
    "octave": -1,
    "detune": 0,
    "level": 0.55,
    "unison_voices": 7,
    "unison_detune": 22,
    "unison_blend": 0.75,
    "unison_width": 0.6
  },
  "filter": {"cutoff": 1100, "resonance": 1.2, "envelope_amount": 1.0, "keytrack": 0.4, "velocity": 0},
  "amp": {"attack": 2.5, "decay": 2.0, "sustain": 1.0, "release": 4.5, "velocity": 0.2},
  "filter_env": {"attack": 3.0, "decay": 6.0, "sustain": 0.5, "release": 4.0},
  "lfo": {"rate": 0.045, "waveform": "tri", "to_cutoff": 0.6},
  "output": {"volume": 1.1},
  "voice": {"drift": 6, "pan_spread": 1.0},
  "motion": {
    "detune1": {"rate": 0.17, "depth": 10},
    "spread": 1.0,
    "meta_rate": 1.5,
    "meta_depth": 0.7,
    "detune2": {"rate": 0.13, "depth": 7},
    "detune3": {"rate": 0.04, "depth": 4}
  },
  "osc": {"unison": {"motion": 6, "motion_rate": 0.15}},
  "audition": {"notes": "D3+A3+E4+F4 _ _ _", "bpm": 60, "step": 2}
}
