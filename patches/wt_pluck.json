{
  "version": 1,
  "engine": "wt",
  "name": "wt_pluck",
  "description": "Glassy pluck: harmonics table whose position (number of harmonics) falls with a short env2, plus a quick filter decay; velocity adds brightness.",
  "params": {
    "a_table": "harmonics",
    "a_position": 0.15,
    "a_level": 0.9,
    "a_unison": 2,
    "a_detune": 6,
    "filter_type": "lp12",
    "cutoff": 1800,
    "resonance": 0.2,
    "keytrack": 0.6,
    "env2_attack": 0.001,
    "env2_decay": 0.25,
    "env2_sustain": 0.0,
    "env2_release": 0.2,
    "amp_attack": 0.001,
    "amp_decay": 0.6,
    "amp_sustain": 0.0,
    "amp_release": 0.4,
    "mod1_source": "env2",
    "mod1_destination": "a_position",
    "mod1_amount": 0.7,
    "mod2_source": "env2",
    "mod2_destination": "cutoff",
    "mod2_amount": 0.4,
    "mod2_via": "velocity",
    "pan_spread": 0.5,
    "delay_mix": 0.25,
    "delay_time": 0.33,
    "delay_pingpong": 1,
    "reverb_mix": 0.2
  },
  "audition": {
    "notes": "C5 G4 E5 C5 B4 G4 D5 B4 A4 E4 C5 A4 G4 D4 B4 G4",
    "bpm": 118,
    "step": 0.25,
    "humanize_velocity": 6,
    "humanize_ms": 4
  }
}
