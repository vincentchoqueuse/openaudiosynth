{
  "version": 2,
  "engine": "va",
  "name": "va_rolling_bass",
  "description": "Rolling progressive-house bass: saw + square one octave down, closed low-pass with a short filter blip, tight envelope; layer it with a sine sub.",
  "osc1": {"waveform": "saw"},
  "osc2": {"waveform": "pulse", "octave": -1, "detune": 0, "level": 0.7},
  "filter": {"cutoff": 320, "resonance": 1.6, "envelope_amount": 1.8, "keytrack": 0.3},
  "amp": {"attack": 0.002, "decay": 0.25, "sustain": 0.55, "release": 0.05},
  "filter_env": {"decay": 0.12, "sustain": 0.1},
  "output": {"volume": 14.7},
  "voice": {"drift": 2, "pan_spread": 0},
  "audition": {"notes": "- - F1 - - - F1 - - - C#1 - - - C#1 -", "bpm": 128, "step": 0.25, "gate": 0.9}
}
