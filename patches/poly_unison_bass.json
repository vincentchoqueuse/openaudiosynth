{
  "version": 1,
  "engine": "poly",
  "name": "poly_unison_bass",
  "description": "Unison bass: all 8 voices on one note, detuned, sub-heavy, plucky filter.",
  "params": {
    "unison": "on",
    "unison_detune": 18,
    "oscb_semi": -12,
    "mix_b": 0.7,
    "cutoff": 300,
    "resonance": 0.3,
    "fenv_amount": 3.0,
    "fenv_decay": 0.2,
    "fenv_sustain": 0.1,
    "amp_sustain": 0.8,
    "amp_release": 0.1,
    "pan_spread": 0.6,
    "volume": 5
  },
  "audition": {
    "notes": "A1 - A1 A2 - A1 - C2 D2 - D2 D3 - D2 E2 G1",
    "bpm": 120,
    "step": 0.25
  }
}
