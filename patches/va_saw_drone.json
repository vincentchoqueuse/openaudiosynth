{
  "version": 2,
  "engine": "va",
  "name": "va_saw_drone",
  "description": "Dark detuned saw drone for the low register: same LFO-of-LFO detune movement, filter almost closed.",
  "osc1": {"waveform": "saw"},
  "osc2": {"waveform": "saw", "octave": -1, "level": 0.7},
  "filter": {"cutoff": 260, "resonance": 1.0, "envelope_amount": 0, "keytrack": 0},
