    "osc2_level": 0.3,
    "cutoff": 1600,
    "resonance": 0.8,
    "keytrack": 0.6,
    "vel_cutoff": 1.5,
    "fenv_amount": 1.2,
    "fenv_attack": 0.002,
    "fenv_decay": 0.8,
    "fenv_sustain": 0.2,
    "amp_attack": 0.004,
    "amp_decay": 2.8,
    "amp_sustain": 0.12,
    "amp_release": 1.4,
    "amp_velocity": 0.6,
    "lfo2_detune": 5,
