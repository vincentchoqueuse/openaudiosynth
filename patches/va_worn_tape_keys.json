{
  "version": 2,
  "engine": "va",
  "name": "va_worn_tape_keys",
  "description": "Keys on a tape left in the sun: the soft chorused keys through the tape machine (slow pitch wander, flutter, rounded peaks, dull highs, hiss), then a dark reverb. The tape sits last in the rack, so the reverb wobbles with the notes.",
  "osc1": {"waveform": "tri"},
  "osc2": {"waveform": "sine", "octave": 1, "detune": 0, "level": 0.3},
  "filter": {"cutoff": 1600, "resonance": 0.8, "envelope_amount": 1.2, "keytrack": 0.6, "velocity": 1.5},
  "amp": {"attack": 0.004, "decay": 2.8, "sustain": 0.12, "release": 1.4, "velocity": 0.6},
  "filter_env": {"attack": 0.002, "decay": 0.8, "sustain": 0.2},
  "output": {"volume": 10},
  "voice": {"drift": 4, "pan_spread": 0.4},
  "motion": {"detune1": {"rate": 0.3, "depth": 5}, "spread": 1.0, "detune2": {"depth": 3}},
  "fx": {
    "reverb": {"mix": 0.35, "decay": 0.9, "damping": 3200},
    "tape": {"mode": "on", "wow": 0.55, "flutter": 0.35, "drive": 0.45, "hiss": 0.3, "tone": 5200}
  }
}
