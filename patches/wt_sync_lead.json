{
  "version": 2,
  "engine": "wt",
  "name": "wt_sync_lead",
  "description": "Screaming sync lead: hard-sync warp swept by env2 and the mod wheel, pulse-width table, a touch of unison.",
  "osc1": {
    "wavetable": "basic",
    "position": 0.8,
    "warp_mode": "sync",
    "warp": 0.15,
    "level": 0.8,
    "unison_voices": 3,
    "unison_detune": 10
  },
  "sub": {"level": 0.3},
  "filter": {"type": "lp12", "cutoff": 6000, "resonance": 0.1},
  "amp": {"release": 0.25},
  "env2": {"attack": 0.002, "decay": 0.5, "sustain": 0.2},
  "lfo1": {"rate": 5.5},
  "mod": {
    "slot1": {"source": "env2", "destination": "a_warp", "amount": 0.6},
    "slot2": {"source": "mod_wheel", "destination": "a_warp", "amount": 0.4},
    "slot3": {"source": "lfo1", "destination": "pitch", "amount": 0.005, "via": "mod_wheel"}
  },
  "voice": {"mode": "legato", "glide": 0.04},
  "output": {"volume": 11.4},
  "fx": {"delay": {"mix": 0.2, "time": 0.375}, "reverb": {"mix": 0.15}}
}
