{
  "version": 2,
  "engine": "va",
  "name": "va_drum_kick",
  "description": "Round analog-style kick: sine with a fast pitch drop (+30 semitones, 35 ms) and a short click; play G1.",
  "osc1": {"waveform": "sine"},
  "osc2": {"level": 0},
