    "osc1_unison": 7, "osc1_unison_detune": 22, "osc1_unison_blend": 0.75, "osc1_unison_width": 0.8,
    "osc2_unison": 7, "osc2_unison_detune": 22, "osc2_unison_blend": 0.75, "osc2_unison_width": 0.6,
    "unison_motion": 6, "unison_motion_rate": 0.15,
    "lfo2_detune": 10, "lfo2_rate": 0.17, "lfo2_spread": 1.0, "lfo3_detune": 7, "lfo3_rate": 0.13,
