{
  "version": 2,
  "engine": "va",
  "name": "va_polymod_bell",
  "description": "Metallic poly-mod bell: osc 2 modulates osc 1 frequency at audio rate (FM), fast decay, no sustain.",
  "osc1": {"waveform": "saw", "octave": 0, "semitone": 0, "pulse_width": 0.5, "level": 0.8, "sync": "off"},
  "osc2": {"waveform": "tri", "octave": 1, "semitone": 7, "detune": 7, "pulse_width": 0.5, "level": 0},
  "noise": {"level": 0},
  "filter": {
    "type": "ladder",
    "cutoff": 4000,
    "resonance": 1.0934,
    "envelope_amount": 1.5,
    "keytrack": 0.5,
    "velocity": 1.0,
    "character": 0.15,
    "oversample": "1x"
  },
  "amp": {"attack": 0.002, "decay": 1.6, "sustain": 0, "release": 1.2, "velocity": 0.5},
  "filter_env": {"attack": 0.005, "decay": 0.4, "sustain": 0, "release": 0.4},
  "lfo": {
    "rate": 5,
    "waveform": "tri",
    "to_pitch": 0.0,
    "to_cutoff": 0.0,
    "to_pulse_width": 0.0,
    "wheel_vibrato": 0.2
  },
  "output": {"volume": 19.1},
  "voice": {
    "drift": 4,
    "pan_spread": 0.4,
    "bend_range": 2,
    "glide": 0,
    "tolerance": 2,
    "drift_time": 3,
    "jitter": 0.2
  },
  "polymod": {"source_osc2": 0.55, "source_filter_env": 0, "target": "pitch"},
  "fx": {"reverb": {"mix": 0.35}}
}
