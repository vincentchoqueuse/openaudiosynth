{
  "version": 2,
  "engine": "va",
  "name": "va_chorus_keys",
  "description": "Soft, slightly chorused electric-piano-like keys: triangle plus a quiet sine an octave up, fast attack and long natural decay, velocity darkens soft notes, a little detune motion. For slow Satie-like bass-then-chord accompaniments.",
  "osc1": {"waveform": "tri"},
  "osc2": {"waveform": "sine", "octave": 1, "detune": 0, "level": 0.3},
  "filter": {"cutoff": 1600, "resonance": 0.8, "envelope_amount": 1.2, "keytrack": 0.6, "velocity": 1.5},
  "amp": {"attack": 0.004, "decay": 2.8, "sustain": 0.12, "release": 1.4, "velocity": 0.6},
  "filter_env": {"attack": 0.002, "decay": 0.8, "sustain": 0.2},
  "output": {"volume": 10},
  "voice": {"drift": 4, "pan_spread": 0.4},
  "motion": {"detune1": {"rate": 0.3, "depth": 5}, "spread": 1.0, "detune2": {"depth": 3}},
  "audition": {"notes": "Eb2 G3+Bb3+D4+F4 _ Eb2 G3+Bb3+D4+F4 _", "bpm": 60, "step": 1, "velocity": 85}
}
