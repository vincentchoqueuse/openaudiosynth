    {"name": "Dark", "value": 0, "targets": [{"param": "havoc.dark", "from": 0, "to": 1.0}]},
    {"name": "Space", "value": 0, "targets": [{"param": "fx.reverb.mix", "from": 0.2, "to": 0.8}]}
