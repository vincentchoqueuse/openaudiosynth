{
  "version": 2,
  "engine": "modal",
  "name": "modal_piano_cold",
  "description": "Cold melancholic piano for ambient: a soft-but-defined hammer on stiff strings, wide unison beating and an even double decay, half pedal (2 s release); each note wavers slightly in pitch like worn tape (slow per-note LFO plus a random offset), and the echoes wobble. Meant to sit far back in a long plate.",
  "resonator": {
    "model": "string",
    "modes": 32,
    "decay": 11,
    "damping": 1.8,
    "release": 2.0,
    "brightness": 0.45,
    "variation": 1.2,
    "inharmonicity": 0.0007,
    "unison": 1.3,
    "decay_keytrack": 0.85,
    "aftersound": 0.3
  },
  "exciter": {"position": 0.13, "hardness": 0.3, "noise": 0.03, "velocity_brightness": 0.7},
  "output": {"volume": 4.7},
  "voice": {"pan_spread": 0.4},
  "fx": {
    "delay": {"mix": 0.12, "time": 0.682, "feedback": 0.4, "tone": 2400, "drive": 0.15, "wow": 0.45},
    "reverb": {"mix": 0.3, "decay": 0.9, "damping": 4500, "predelay": 0.05}
  },
  "vlfo": {"rate": 0.33, "waveform": "sine"},
  "vroute1": {"source": "vlfo", "destination": "pitch", "amount": 0.0035},
  "vroute2": {"source": "random", "destination": "pitch", "amount": 0.002}
}
