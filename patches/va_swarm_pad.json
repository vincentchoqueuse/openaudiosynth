    "cutoff": 1100, "resonance": 1.2, "keytrack": 0.4, "vel_cutoff": 0,
    "fenv_amount": 1.0, "fenv_attack": 3.0, "fenv_decay": 6.0, "fenv_sustain": 0.5, "fenv_release": 4.0,
    "amp_attack": 2.5, "amp_decay": 2.0, "amp_sustain": 1.0, "amp_release": 4.5, "amp_velocity": 0.2,
