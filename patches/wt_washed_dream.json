{
  "version": 2,
  "engine": "wt",
  "name": "wt_washed_dream",
  "description": "Washed lo-fi ambient: a soft, detuned wavetable pad that fades in over seconds, a dark low-pass breathing with two slow LFOs, ensemble chorus and a long, wide reverb; major-ninth and minor-eleventh chords that melt into each other.",
  "osc1": {"wavetable": "basic", "position": 0.12, "level": 0.7, "unison_voices": 4, "unison_detune": 12},
  "osc2": {
    "wavetable": "harmonics",
    "position": 0.3,
    "level": 0.25,
    "octave": 1,
    "unison_voices": 2,
    "unison_detune": 8
  },
  "sub": {"level": 0.2},
  "noise": {"level": 0.03},
  "filter": {"type": "lp12", "cutoff": 2000, "resonance": 0.08, "keytrack": 0.3},
  "amp": {"attack": 2.5, "decay": 3.0, "sustain": 0.85, "release": 6.0},
  "lfo1": {"rate": 0.07, "retrigger": "off"},
  "lfo2": {"rate": 0.045, "retrigger": "off"},
  "mod": {
    "slot1": {"source": "lfo1", "destination": "cutoff", "amount": 0.18},
    "slot2": {"source": "lfo2", "destination": "a_position", "amount": 0.25},
    "slot3": {"source": "random", "destination": "pan", "amount": 0.3}
  },
  "output": {"volume": -2.4},
  "voice": {"pan_spread": 0.8},
  "fx": {
    "chorus": {"mode": "ensemble", "mix": 0.4},
    "delay": {"mix": 0.2, "time": 0.66, "feedback": 0.5, "tone": 2400},
    "reverb": {"mix": 0.55, "decay": 0.95, "damping": 3000}
  }
}
