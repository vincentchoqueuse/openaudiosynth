{
  "version": 2,
  "engine": "micro",
  "name": "micro_low_line",
  "description": "A bass line that is only weight: whatever key is played lands between 41 and 82 Hz, starts from the top of its sine (its own click), holds, and stops on the sample.",
  "osc1": {"level": -60},
  "amp": {"attack": 0.001, "decay": 0.05, "sustain": 0, "velocity": 0.3},
  "micro": {
    "click_mode": "impulse",
    "click_level": -14,
    "click_tone": 3500,
    "low_level": 5,
    "low_mode": "note",
    "low_freq": 41.2,
    "low_phase": 90,
    "low_drop": 7,
    "low_drop_time": 0.015,
    "low_attack": 2e-05,
    "low_hold": 0.16,
    "low_decay": 0.12,
    "low_curve": -0.4,
    "low_drive": 0.55
  },
  "output": {"volume": 1.2},
  "tempo": {"bpm": 120}
}
