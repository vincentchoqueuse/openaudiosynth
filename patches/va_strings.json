{
  "version": 2,
  "engine": "va",
  "name": "va_strings",
  "description": "Lush string-machine-like pad: pulse waves with slow LFO PWM, slow attack and release, chorus ensemble.",
  "osc1": {"waveform": "pulse", "octave": 0, "semitone": 0, "pulse_width": 0.5, "level": 0.8, "sync": "off"},
  "osc2": {"waveform": "pulse", "octave": 0, "semitone": 0, "detune": 6, "pulse_width": 0.5, "level": 0.6},
  "noise": {"level": 0},
  "filter": {
    "type": "ladder",
    "cutoff": 2400,
    "resonance": 1.0934,
    "envelope_amount": 0.5,
    "keytrack": 0.5,
    "velocity": 1.0,
    "character": 0.15,
    "oversample": "1x"
  },
  "amp": {"attack": 0.6, "decay": 0.4, "sustain": 0.8, "release": 1.5, "velocity": 0.5},
  "filter_env": {"attack": 0.005, "decay": 0.5, "sustain": 0.3, "release": 0.4},
  "lfo": {
    "rate": 0.6,
    "waveform": "tri",
    "to_pitch": 0.0,
    "to_cutoff": 0.0,
    "to_pulse_width": 0.28,
    "wheel_vibrato": 0.0
  },
  "output": {"volume": 2.3},
  "voice": {
    "drift": 4,
    "pan_spread": 0.8,
    "bend_range": 2,
    "glide": 0,
    "tolerance": 2,
    "drift_time": 3,
    "jitter": 0.2
  },
  "fx": {"chorus": {"mode": "ensemble", "mix": 0.5}, "reverb": {"mix": 0.3}},
  "audition": {"notes": "D3+A3+F4 _ _ _ C3+G3+E4 _ _ _", "bpm": 70, "step": 1}
}
