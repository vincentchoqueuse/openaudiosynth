{
  "version": 1,
  "engine": "va",
  "name": "portable_pad",
  "description": "Example of a portable patch written only with roles (no engine-specific names): any OID instrument exposing these roles can load it.",
  "params": {
    "osc1.waveform": "saw",
    "osc2.waveform": "saw",
    "osc2.detune": 9,
    "filter.cutoff": 900,
    "filter.resonance": 1.2,
    "amp.attack": 1.2,
    "amp.release": 2.5,
    "motion.detune1.depth": 12,
    "motion.detune1.rate": 0.2,
    "voice.drift": 5,
    "fx.chorus.mode": "ensemble",
    "fx.chorus.mix": 0.4,
    "fx.reverb.mix": 0.4,
    "fx.reverb.decay": 0.9
  },
  "audition": {
    "notes": "D3+A3+E4 _ _ _",
    "bpm": 60,
    "step": 2
  }
}
