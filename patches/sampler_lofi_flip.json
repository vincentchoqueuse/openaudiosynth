    "tune": -3,
    "velocity": 0.8,
    "resonance": 0.9,
    "pad1_cutoff": 2500,
    "pad1_end": 0.55,
    "pad3_cutoff": 4500,
    "pad3_reverse": "on",
    "pad3_start": 0.0,
    "pad3_end": 0.45,
    "pad3_level": -4,
    "pad4_cutoff": 3500,
    "pad6_cutoff": 6000,
    "pad6_choke": 1,
    "pad8_choke": 1,
    "pad8_decay": 0.6,
    "pad8_cutoff": 5000,
    "pad6_pan": 0.2,
    "chorus_mode": "I",
    "reverb_mix": 0.12
  },
  "macros": [
    {
      "name": "Tape speed",
      "value": 0.5,
      "targets": [
        {
          "param": "tune",
          "from": 0,
          "to": -6
        }
      ]
    },
    {
      "name": "Dust",
      "value": 0.3,
      "targets": [
        {
          "param": "pad1_cutoff",
          "from": 4000,
          "to": 800
        },
        {
          "param": "pad3_cutoff",
          "from": 7000,
          "to": 1500
        },
        {
          "param": "pad4_cutoff",
          "from": 6000,
          "to": 1200
        },
        {
          "param": "pad6_cutoff",
          "from": 9000,
          "to": 2000
        },
        {
          "param": "pad8_cutoff",
          "from": 8000,
          "to": 1800
        }
      ]
    },
    {
      "name": "Hats",
      "value": 0.5,
      "targets": [
        {
          "param": "pad6_level",
          "from": -18,
          "to": 0
        },
        {
          "param": "pad8_level",
          "from": -18,
          "to": 0
        }
      ]
    }
  ],
  "audition": {
    "notes": "C2! F#2? F#2 D2? D2+F#2 F#2? C2 C2? F#2 F#2? C2+A#2 F#2? D2+D#2 F#2? F#2 F#2?",
