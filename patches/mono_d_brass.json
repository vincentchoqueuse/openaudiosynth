{
  "version": 2,
  "engine": "mono",
  "name": "mono_d_brass",
  "description": "Synth brass: two sawtooths, a slow-opening contour on the ladder, multiple triggering. With the mod wheel up, the reissue's filter-contour modulation (source A = filter contour) makes each note scoop up into pitch as the filter opens.",
  "osc1": {"octave": "8", "waveform": "saw", "level": 0.8},
  "osc2": {"octave": "8", "waveform": "saw", "detune": 0.06, "level": 0.8},
  "osc3": {"level": 0},
  "filter": {"drive": 0.3, "cutoff": 500, "resonance": 0.15, "envelope_amount": 2.8, "keytrack": 0.66},
  "filter_env": {"attack": 0.06, "decay": 0.5, "sustain": 0.6},
  "amp": {"attack": 0.03, "decay": 0.4, "sustain": 0.9, "velocity": 0.4},
  "env": {"release_switch": "on"},
  "voice": {"mode": "mono", "bend_range": 7, "priority": "last"},
  "mod": {"mix": 0.0, "to_pitch": 0.6, "source_a": "filter_eg"},
  "output": {"volume": 8.6},
  "fx": {"reverb": {"mix": 0.15}},
  "audition": {"notes": "C4 _ _ E4 G4 _ _ _ F4 _ _ A4 G4 _ _ -", "bpm": 88, "step": 0.5, "gate": 0.9}
}
