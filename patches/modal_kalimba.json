{
  "version": 1,
  "engine": "modal",
  "name": "modal_kalimba",
  "description": "Kalimba / music-box tine: free bar struck near the end (position), bright metal attack, medium ring; with a ping-pong tape echo.",
  "params": {
    "model": "bar",
