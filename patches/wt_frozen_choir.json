{
  "version": 2,
  "engine": "wt",
  "name": "wt_frozen_choir",
  "description": "Frozen choir: vowel wavetables morphing slowly (each voice on its own MSEG) with breath noise through a bright comb two octaves up whose tuning steps randomly a little on each voice (sample-and-hold LFO): a cold, glittering choir in a huge space.",
  "osc1": {"wavetable": "vowel", "position": 0.4, "level": 0.5, "unison_voices": 5, "unison_detune": 10},
  "osc2": {"wavetable": "harmonics", "position": 0.8, "level": 0.2, "octave": 1},
  "sub": {"level": 0.3},
  "noise": {"level": 0.18},
  "filter": {"type": "comb", "cutoff": 1046.5, "resonance": 0.8, "drive": 0.5, "keytrack": 1.0},
  "amp": {"attack": 2.5, "decay": 2.0, "sustain": 1.0, "release": 8.0, "velocity": 0.3},
  "output": {"volume": 9.9},
  "voice": {"pan_spread": 0.9},
  "fx": {
    "delay": {"mix": 0.18, "feedback": 0.6, "tone": 4500, "pingpong": "on", "sync": "1/4d"},
    "reverb": {"mix": 0.55, "decay": 0.95, "damping": 7000, "predelay": 0.08}
  },
  "tempo": {"bpm": 64},
  "mlfo1": {"rate": 0.03},
  "route1": {"source": "mlfo1", "destination": "osc1.position", "amount": 0.25},
  "vmseg": {
    "mode": "loop_free",
    "points": 4,
    "sustain": "none",
    "loop_start": "1",
    "loop_end": "4",
    "point1": {"time": 0, "level": 0.1, "curve": 0},
    "point2": {"time": 6.0, "level": 0.9, "curve": -0.6},
    "point3": {"time": 5.0, "level": 0.3, "curve": 0.6},
    "point4": {"time": 7.0, "level": 0.7, "curve": -0.3}
  },
  "vlfo": {"rate": 0.11, "waveform": "sh"},
  "vroute1": {"source": "vlfo", "destination": "brightness", "amount": 0.03},
  "vroute2": {"source": "vmseg", "destination": "timbre", "amount": 0.4},
  "vroute3": {"source": "velocity", "destination": "brightness", "amount": 0.05}
}
