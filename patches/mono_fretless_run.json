  "amp": {"attack": 0.003, "decay": 0.4, "sustain": 0.85, "velocity": 0.4},
  "voice": {"glide": 0.06, "mode": "legato"},
  "output": {"volume": 10.2},
  "fx": {"reverb": {"mix": 0.1}}
