{
  "version": 1,
  "name": "drift",
  "description": "Ambient piece in the spirit of early-90s bedroom ambient: two chords only, the movement comes from LFO-modulated detune (LFO of LFO), a dark drone, sub swells that come and go, sparse glass bells, tape-like air and a long plate reverb.",
  "bpm": 60,
  "length_beats": 96,
  "tail_s": 10,
  "tracks": [
