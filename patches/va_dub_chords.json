{
  "version": 2,
  "engine": "va",
  "name": "va_dub_chords",
  "description": "Dub-style offbeat chords: short filtered saws thrown into a dark ping-pong tape echo with high feedback and a plate reverb.",
  "osc2": {"detune": 9, "level": 0.8},
  "filter": {"cutoff": 900, "resonance": 2, "envelope_amount": 2.5},
  "amp": {"attack": 0.002, "decay": 0.25, "sustain": 0, "release": 0.1},
  "filter_env": {"decay": 0.15, "sustain": 0},
  "output": {"volume": 11.9},
  "voice": {"pan_spread": 0},
  "fx": {
    "delay": {"mix": 0.5, "time": 0.375, "feedback": 0.65, "tone": 2000, "drive": 0.5, "wow": 0.35, "pingpong": "on"},
    "reverb": {"mix": 0.3, "decay": 0.85, "damping": 3000}
  },
  "audition": {"notes": "- D3+F3+A3 - D3+F3+A3 - C3+E3+G3 - C3+E3+G3", "bpm": 75, "step": 0.5}
}
