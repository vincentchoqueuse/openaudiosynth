  "lfo": {"rate": 0.03, "waveform": "sine", "to_cutoff": 0.4},
  "output": {"volume": 3.8},
  "voice": {"drift": 6, "pan_spread": 0.4},
  "motion": {
    "detune1": {"rate": 0.09, "depth": 10},
    "spread": 1.0,
    "meta_rate": 1.0,
    "meta_depth": 0.5,
    "detune2": {"rate": 0.069, "depth": 7},
    "detune3": {"rate": 0.021, "depth": 3}
  }
