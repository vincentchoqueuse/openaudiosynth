{
  "version": 2,
  "engine": "va",
  "name": "va_talking_pad",
  "description": "Talking pad: two detuned saws through two formant filters in parallel (an adult voice and a smaller one), a looping MSEG walks the first filter through the vowels a-e-i-o-u, a slow LFO moves the second: the chord slowly speaks.",
  "osc1": {"waveform": "saw"},
  "osc2": {"waveform": "saw", "detune": 9},
  "filter": {
    "type": "formant",
    "cutoff": 1000,
    "resonance": 4,
    "envelope_amount": 0,
    "keytrack": 0,
    "character": 0.0,
    "routing": "parallel"
  },
  "amp": {"attack": 0.8, "sustain": 0.9, "release": 3.0},
  "output": {"volume": 9.2},
  "voice": {"pan_spread": 0.6},
  "filter2": {"type": "formant", "cutoff": 1400, "resonance": 0.5, "character": 0.6},
  "fx": {"chorus": {"mode": "ensemble", "mix": 0.3}, "reverb": {"mix": 0.4, "decay": 0.9}},
  "part": {"level": 9},
  "mlfo1": {"rate": 0.13},
  "mseg1": {
    "mode": "loop_free",
    "points": 5,
    "loop_start": "1",
    "loop_end": "5",
    "point1": {"level": 0.0},
    "point2": {"time": 2.5, "level": 0.25, "curve": -0.4},
    "point3": {"time": 2.0, "level": 0.75, "curve": 0.3},
    "point4": {"time": 3.0, "level": 0.5, "curve": 0},
    "point5": {"time": 2.5, "level": 1.0, "curve": -0.3}
  },
  "route1": {"source": "mseg1", "destination": "filter.character", "amount": 1.0},
  "route2": {"source": "mlfo1", "destination": "filter2.character", "amount": 0.3},
  "audition": {"notes": "A2+E3+C4 _ _ _ _ _ _ _ F2+C3+A3 _ _ _ _ _ _ _", "bpm": 60, "step": 1}
}
