{
  "version": 2,
  "engine": "wt",
  "name": "wt_growl_bass",
  "description": "Talking growl bass: phase-modulation table swept by a tempo-like LFO on position and cutoff, sub underneath, driven 24 dB ladder.",
  "osc1": {"wavetable": "growl", "position": 0.6, "level": 0.9, "unison_voices": 2, "unison_detune": 8},
  "sub": {"level": 0.35},
  "filter": {"type": "lp24", "cutoff": 2600, "resonance": 0.45, "drive": 0.5, "keytrack": 0.5},
  "amp": {"attack": 0.003, "release": 0.12},
  "env2": {"decay": 0.25, "sustain": 0.0},
  "lfo1": {"rate": 3.0, "waveform": "tri"},
  "mod": {
    "slot1": {"source": "lfo1", "destination": "a_position", "amount": 0.35},
    "slot2": {"source": "lfo1", "destination": "cutoff", "amount": 0.35},
    "slot3": {"source": "env2", "destination": "cutoff", "amount": 0.3}
  },
  "voice": {"mode": "mono"},
  "output": {"volume": 17.4}
}
