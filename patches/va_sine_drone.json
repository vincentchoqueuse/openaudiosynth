{
  "version": 2,
  "engine": "va",
  "name": "va_sine_drone",
  "description": "Pure sine drone: two sines a few cents apart beat slowly (moving interference), no filter colour, slow swell. Microsound / installation backdrop.",
  "osc1": {"waveform": "sine"},
  "osc2": {"waveform": "sine", "detune": 2.5, "level": 1.0},
  "filter": {"cutoff": 20000, "resonance": 0.7, "envelope_amount": 0, "keytrack": 0},
  "amp": {"attack": 3, "sustain": 1, "release": 4},
  "output": {"volume": 3.2},
  "voice": {"drift": 0, "pan_spread": 0.8},
  "motion": {"detune1": {"rate": 0.05, "depth": 1.5}},
  "audition": {"notes": "A1+A5 _ _ _", "bpm": 60, "step": 2}
}
