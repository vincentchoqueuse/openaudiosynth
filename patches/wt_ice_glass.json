{
  "version": 2,
  "engine": "wt",
  "name": "wt_ice_glass",
  "description": "Cold glass texture in the spirit of early-2000s spectral synths: a resonant table ring-modulated by a digital one, a looping 6-point MSEG stepping the wavetable position (each step glides), slow LFOs on the second table and a band-pass, long plate and dotted-eighth echoes. No chorus: it stays glassy.",
  "osc1": {"wavetable": "resonant", "position": 0.35, "warp_mode": "ring", "warp": 0.55, "level": 0.8, "octave": 1},
  "osc2": {
    "wavetable": "digital",
    "position": 0.5,
    "level": 0.25,
    "semitone": 7,
    "unison_voices": 2,
    "unison_detune": 4
  },
  "filter": {"type": "bp12", "cutoff": 2600, "resonance": 0.45, "keytrack": 0.6},
  "amp": {"attack": 1.4, "decay": 2.0, "sustain": 0.85, "release": 4.0},
  "output": {"volume": 13.7},
  "voice": {"pan_spread": 0.8},
  "fx": {
    "delay": {"mix": 0.22, "feedback": 0.55, "tone": 6000, "pingpong": "on", "sync": "1/8d"},
    "reverb": {"mix": 0.5, "decay": 0.94, "damping": 9000, "predelay": 0.06}
  },
  "tempo": {"bpm": 72},
  "part": {"level": 3},
  "mlfo1": {"rate": 0.07},
  "mlfo2": {"sync": "2", "waveform": "tri"},
  "mseg1": {
    "mode": "loop_free",
    "sync": "seconds",
    "points": 6,
    "sustain": "none",
    "loop_start": "1",
    "loop_end": "6",
    "point1": {"time": 0, "level": 0.1, "curve": 0},
    "point2": {"time": 0.45, "level": 0.85, "curve": -0.6},
    "point3": {"time": 0.45, "level": 0.3, "curve": -0.6},
    "point4": {"time": 0.45, "level": 0.95, "curve": -0.6},
    "point5": {"time": 0.45, "level": 0.15, "curve": -0.6},
    "point6": {"time": 0.45, "level": 0.6, "curve": -0.6}
  },
  "route1": {"source": "mseg1", "destination": "osc1.position", "amount": 0.55},
  "route2": {"source": "mlfo1", "destination": "osc2.position", "amount": 0.4},
  "route3": {"source": "mlfo2", "destination": "filter.cutoff", "amount": 0.12},
  "route4": {"source": "mod_wheel", "destination": "osc1.warp", "amount": 0.4},
  "audition": {
    "notes": "E4+B4+F#5 _ _ _ _ _ _ _ C4+G4+D5 _ _ _ _ _ _ _",
    "bpm": 60,
    "step": 1,
    "velocity": 90,
    "humanize_velocity": 8,
    "humanize_ms": 10
  }
}
