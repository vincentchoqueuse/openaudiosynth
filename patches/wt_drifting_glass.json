{
  "version": 2,
  "engine": "wt",
  "name": "wt_drifting_glass",
  "description": "Drifting glass: the crystal pad left to itself. Six macros (table position, warp, cutoff, resonance, delay, reverb) each follow their own slow random walk (wander), so a held chord keeps changing colour and place and never passes twice through the same sound.",
  "osc1": {
    "wavetable": "harmonics",
    "position": 0.75,
    "warp_mode": "sync",
    "warp": 0.1,
    "level": 0.6,
    "octave": 1,
    "unison_voices": 4,
    "unison_detune": 6
  },
  "osc2": {"wavetable": "basic", "position": 0.0, "level": 0.25, "octave": 2},
  "noise": {"level": 0.04},
  "filter": {"type": "hp12", "cutoff": 500, "resonance": 0.25},
  "amp": {"attack": 2.0, "decay": 1.0, "sustain": 1.0, "release": 5.0},
  "output": {"volume": 0.4},
  "voice": {"pan_spread": 0.9},
  "fx": {
    "delay": {"mix": 0.22, "feedback": 0.55, "tone": 6000, "pingpong": "on", "sync": "1/8d"},
    "reverb": {"mix": 0.5, "decay": 0.94, "damping": 9000, "predelay": 0.06}
  },
  "tempo": {"bpm": 72},
  "mlfo1": {"sync": "1", "waveform": "sh"},
  "mlfo2": {"rate": 0.09},
  "mseg1": {
    "mode": "loop_free",
    "sync": "seconds",
    "points": 3,
    "sustain": "none",
    "loop_start": "1",
    "loop_end": "3",
    "point1": {"time": 0, "level": 0.0, "curve": 0},
    "point2": {"time": 0.6, "level": 1.0, "curve": 0.7},
    "point3": {"time": 1.8, "level": 0.0, "curve": -0.7}
  },
  "mseg2": {
    "mode": "loop_free",
    "sync": "seconds",
    "points": 3,
    "sustain": "none",
    "loop_start": "1",
    "loop_end": "3",
    "point1": {"time": 0, "level": 0.3, "curve": 0},
    "point2": {"time": 4.0, "level": 0.9, "curve": 0},
    "point3": {"time": 6.0, "level": 0.2, "curve": 0}
  },
  "route1": {"source": "mseg1", "destination": "osc1.warp", "amount": 0.25},
  "route2": {"source": "mlfo1", "destination": "osc1.position", "amount": 0.15},
  "route3": {"source": "mseg2", "destination": "noise.level", "amount": 0.15},
  "route4": {"source": "mlfo2", "destination": "osc2.position", "amount": 0.3},
  "wander": {"amount": 0.8, "rate": 0.11},
  "macros": [
    {"name": "Position", "value": 0.5, "targets": [{"param": "osc1.position", "from": 0.2, "to": 1.0}]},
    {"name": "B position", "value": 0.5, "targets": [{"param": "osc2.position", "from": 0.0, "to": 0.9}]},
    {"name": "Warp", "value": 0.4, "targets": [{"param": "osc1.warp", "from": 0.0, "to": 0.5}]},
    {"name": "Cutoff", "value": 0.55, "targets": [{"param": "filter.cutoff", "from": 112.5, "to": 10023.7}]},
    {"name": "Echoes", "value": 0.4, "targets": [{"param": "fx.delay.mix", "from": 0.0, "to": 0.45}]},
    {"name": "Space", "value": 0.6, "targets": [{"param": "fx.reverb.mix", "from": 0.25, "to": 0.8}]}
  ]
}
