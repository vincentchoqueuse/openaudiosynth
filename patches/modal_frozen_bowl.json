{
  "version": 2,
  "engine": "modal",
  "name": "modal_frozen_bowl",
  "description": "Frozen singing bowl: an inharmonic (stretched) bowl, struck then bowed with a slow attack; a slow looping MSEG walks the bow position across the modes (partials rise and fall in turn), an LFO breathes the inharmonicity, another the brightness. Huge cold plate.",
  "resonator": {
    "model": "bowl",
    "modes": 24,
    "stretch": 0.25,
    "decay": 18,
    "damping": 0.35,
    "release": 6,
    "brightness": 0.75,
    "variation": 3
  },
  "exciter": {"position": 0.3, "hardness": 0.8, "noise": 0.02, "bow": 0.45, "bow_attack": 2.5},
  "output": {"volume": 5.1},
  "voice": {"pan_spread": 0.7},
  "fx": {
    "delay": {"mix": 0.12, "feedback": 0.55, "tone": 6000, "pingpong": "on", "sync": "1/8d"},
    "reverb": {"mix": 0.5, "decay": 0.94, "damping": 9000, "predelay": 0.06}
  },
  "tempo": {"bpm": 72},
  "mlfo1": {"rate": 0.05},
  "mlfo2": {"rate": 0.13},
  "mseg1": {
    "mode": "loop_free",
    "sync": "seconds",
    "points": 5,
    "sustain": "none",
    "loop_start": "1",
    "loop_end": "5",
    "point1": {"time": 0, "level": 0.2, "curve": 0},
    "point2": {"time": 3.0, "level": 0.8, "curve": 0.3},
    "point3": {"time": 4.0, "level": 0.35, "curve": -0.3},
    "point4": {"time": 3.5, "level": 0.9, "curve": 0.2},
    "point5": {"time": 5.0, "level": 0.2, "curve": -0.2}
  },
  "route1": {"source": "mseg1", "destination": "exciter.position", "amount": 0.35},
  "route2": {"source": "mlfo1", "destination": "resonator.stretch", "amount": 0.02},
  "route3": {"source": "mlfo2", "destination": "resonator.brightness", "amount": 0.15},
  "route4": {"source": "aftertouch", "destination": "exciter.bow", "amount": 0.4},
  "audition": {
    "notes": "A3 _ _ _ _ _ _ _ E4 _ _ _ _ _ _ _",
    "bpm": 50,
    "step": 1,
    "velocity": 90,
    "humanize_velocity": 8,
    "humanize_ms": 10
  }
}
