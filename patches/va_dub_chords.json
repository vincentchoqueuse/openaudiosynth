{
  "version": 1,
  "engine": "va",
  "name": "va_dub_chords",
  "description": "Dub-style offbeat chords: short filtered saws thrown into a dark ping-pong tape echo with high feedback and a plate reverb.",
  "params": {
    "volume": 11.9,
    "osc2_detune": 9,
    "osc2_level": 0.8,
    "cutoff": 900,
    "resonance": 2,
    "fenv_amount": 2.5,
    "fenv_decay": 0.15,
    "fenv_sustain": 0,
    "amp_attack": 0.002,
    "amp_decay": 0.25,
    "amp_sustain": 0,
    "amp_release": 0.1,
    "pan_spread": 0,
    "delay_mix": 0.5,
    "delay_time": 0.375,
    "delay_pingpong": "on",
    "delay_feedback": 0.65,
    "delay_tone": 2000,
    "delay_drive": 0.5,
    "delay_wow": 0.35,
    "reverb_mix": 0.3,
    "reverb_decay": 0.85,
    "reverb_damping": 3000
  },
  "audition": {
    "notes": "- D3+F3+A3 - D3+F3+A3 - C3+E3+G3 - C3+E3+G3",
    "bpm": 75,
    "step": 0.5
  }
}
