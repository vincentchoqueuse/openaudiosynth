{
  "version": 2,
  "engine": "va",
  "name": "va_flute_lead",
  "description": "Breathy, flute-like melody voice: triangle with a hint of noise, soft attack, gentle delayed-feel vibrato, slight detune motion and drift. Meant to sing slowly above pads, drenched in reverb.",
  "osc1": {"waveform": "tri"},
  "osc2": {"waveform": "sine", "detune": 6, "level": 0.5},
  "noise": {"level": 0.04},
  "filter": {"cutoff": 2400, "resonance": 0.9, "envelope_amount": 0.6, "keytrack": 0.5},
  "amp": {"attack": 0.09, "decay": 1.2, "sustain": 0.7, "release": 1.8, "velocity": 0.4},
  "filter_env": {"attack": 0.25, "decay": 1.5},
  "lfo": {"rate": 4.8, "waveform": "sine", "to_pitch": 0.07},
  "output": {"volume": 10.2},
  "voice": {"drift": 5, "pan_spread": 0},
  "motion": {"detune1": {"rate": 0.2, "depth": 4}}
}
