    "point3": {"time": 0.25, "level": 0.3, "curve": -0.5},
    "point4": {"time": 0.75, "level": 1.0, "curve": 0.3},
    "point5": {"time": 0.5, "level": 0.1, "curve": -0.6}
  },
  "route1": {"source": "mseg1", "destination": "filter.drive", "amount": 0.6},
  "route2": {"source": "mseg1", "destination": "fx.distortion.drive", "amount": 0.4},
  "route3": {"source": "mlfo1", "destination": "fx.distortion.drive", "amount": 0.15, "via": "mseg1"},
  "route4": {"source": "mlfo2", "destination": "filter.cutoff", "amount": 0.08},
