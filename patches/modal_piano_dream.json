{
  "version": 2,
  "engine": "modal",
  "name": "modal_piano_dream",
  "description": "A piano remembered: the ambient grand through a worn tape, into a long reverb whose tail rises a fifth and an octave (shimmer on the fifth), the echoes and the space drifting by themselves. Play few notes and leave room.",
  "resonator": {
    "model": "string",
    "modes": 32,
    "decay": 14,
    "damping": 1.4,
    "release": 2.5,
    "brightness": 0.6,
    "variation": 1.0,
    "inharmonicity": 0.0006,
    "unison": 1.6,
    "decay_keytrack": 0.85,
    "aftersound": 0
  },
  "exciter": {"position": 0.125, "hardness": 0.6, "noise": 0.04, "velocity_brightness": 0.8},
  "output": {"volume": 3},
  "voice": {"pan_spread": 0.35},
  "master": {"level": -4},
  "fx": {
    "delay": {"mix": 0.2, "time": 0.75, "feedback": 0.5, "tone": 2500},
    "reverb": {
      "mix": 0.6,
      "decay": 0.95,
      "damping": 6000,
      "predelay": 0.05,
      "shimmer": 0.5,
      "shimmer_pitch": "fifth_up"
    },
    "rack": {"slot1": "tape"},
    "tape": {"mode": "on", "wow": 0.4, "flutter": 0.15, "drive": 0.35, "hiss": 0.2, "tone": 6500}
  },
  "wander": {"amount": 0.6, "rate": 0.07},
  "macros": [
    {"name": "Echoes", "value": 0.4, "targets": [{"param": "fx.delay.mix", "from": 0.05, "to": 0.4}]},
    {"name": "Space", "value": 0.6, "targets": [{"param": "fx.reverb.mix", "from": 0.35, "to": 0.8}]},
    {"name": "Glow", "value": 0.5, "targets": [{"param": "fx.reverb.shimmer", "from": 0.2, "to": 0.75}]},
    {
      "name": "Wear",
      "value": 0.4,
      "targets": [
        {"param": "fx.tape.wow", "from": 0.15, "to": 0.7},
        {"param": "fx.tape.tone", "from": 8738.9, "to": 3671.7}
      ]
    }
  ]
}
