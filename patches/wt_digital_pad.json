{
  "version": 2,
  "engine": "wt",
  "name": "wt_digital_pad",
  "description": "Evolving digital pad: random-spectrum table scanned by two slow LFOs, mirror warp breathing, wide unison, long tails.",
  "osc1": {
    "wavetable": "digital",
    "position": 0.18,
    "warp_mode": "mirror",
    "warp": 0.1,
    "level": 0.6,
    "unison_voices": 6,
    "unison_detune": 18
  },
  "osc2": {
    "wavetable": "harmonics",
    "position": 0.4,
    "level": 0.3,
    "octave": 0,
    "unison_voices": 3,
    "unison_detune": 9
  },
  "filter": {"type": "lp12", "cutoff": 2400, "resonance": 0.1},
  "amp": {"attack": 1.5, "sustain": 1.0, "release": 3.0},
  "lfo1": {"rate": 0.08, "retrigger": "off"},
  "lfo2": {"rate": 0.13, "retrigger": "off"},
  "mod": {
    "slot1": {"source": "lfo1", "destination": "a_position", "amount": 0.35},
    "slot2": {"source": "lfo2", "destination": "a_warp", "amount": 0.2},
    "slot3": {"source": "lfo2", "destination": "b_position", "amount": 0.3},
    "slot4": {"source": "lfo1", "destination": "cutoff", "amount": 0.1}
  },
  "output": {"volume": 4.8},
  "voice": {"pan_spread": 0.8},
  "fx": {
    "chorus": {"mode": "ensemble", "mix": 0.3},
    "delay": {"mix": 0.15, "time": 0.6},
    "reverb": {"mix": 0.45, "decay": 0.92}
  }
}
