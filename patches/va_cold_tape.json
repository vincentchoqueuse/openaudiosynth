{
  "version": 2,
  "engine": "va",
  "name": "va_cold_tape",
  "description": "Cold tape pad, the hazy tape's winter sibling: glassy pulses and a thin saw drifting apart, a hollow resonance, the same worn tape wobble, a bright, airy hall; open add9 and maj7(#11) chords with a few high, lonely notes.",
  "osc1": {"waveform": "saw", "octave": 0, "semitone": 0, "pulse_width": 0.5, "level": 0.45, "sync": "off"},
  "osc2": {"waveform": "pulse", "octave": 0, "semitone": 0, "detune": -6, "pulse_width": 0.22, "level": 0.9},
  "noise": {"level": 0.03},
  "filter": {
    "type": "ladder",
    "cutoff": 1100,
    "resonance": 1.9661,
    "envelope_amount": 1.0,
    "keytrack": 0.5,
    "velocity": 1.0,
    "character": 0.15,
    "oversample": "1x"
  },
  "amp": {"attack": 0.5, "decay": 2.5, "sustain": 0.8, "release": 3.2, "velocity": 0.5},
  "filter_env": {"attack": 1.2, "decay": 4.0, "sustain": 0.3, "release": 3.0},
  "lfo": {
    "rate": 5,
    "waveform": "tri",
    "to_pitch": 0.0,
    "to_cutoff": 0.0,
    "to_pulse_width": 0.0,
    "wheel_vibrato": 0.2
  },
  "output": {"volume": 3.0},
  "voice": {
    "drift": 6,
    "pan_spread": 0.8,
    "bend_range": 2,
    "glide": 0,
    "tolerance": 3,
    "drift_time": 8,
    "jitter": 0.4
  },
  "fx": {
    "chorus": {"mode": "I", "mix": 0.25},
    "delay": {"mix": 0.22, "time": 0.83, "feedback": 0.45, "tone": 3200, "drive": 0.25, "wow": 0.5},
    "reverb": {"mix": 0.42, "decay": 0.92, "damping": 6500}
  },
  "mlfo1": {"rate": 0.05, "waveform": "wiener"},
  "route1": {"source": "mlfo1", "destination": "filter.cutoff", "amount": 0.07},
  "vlfo": {"rate": 0.25, "waveform": "wiener"},
  "vroute1": {"source": "vlfo", "destination": "pitch", "amount": 0.01}
}
