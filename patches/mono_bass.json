{
  "version": 2,
  "engine": "mono",
  "name": "mono_bass",
  "description": "Fat classic monosynth bass: two saws at 16' slightly detuned + square at 32', mixer pushed into the ladder, plucky contour.",
  "osc1": {"octave": "16", "waveform": "saw"},
  "osc2": {"octave": "16", "waveform": "saw", "detune": 0.08},
  "osc3": {"octave": "32", "waveform": "square", "level": 0.5},
  "filter": {"drive": 0.6, "cutoff": 260, "resonance": 0.3, "envelope_amount": 3.0, "keytrack": 0.33},
  "filter_env": {"decay": 0.25, "sustain": 0.15},
  "amp": {"decay": 0.6, "sustain": 0.8, "velocity": 0.4},
  "output": {"volume": 10.7}
}
