{
  "version": 2,
  "engine": "va",
  "name": "va_detroit_stab",
  "description": "Detroit chord stab: one minor-ninth chord shape moved by hand, short and plucky through a resonant filter, echoing on a dotted-eighth delay, pumping on every beat.",
  "osc1": {"waveform": "saw"},
  "osc2": {"waveform": "pulse", "detune": 8, "pulse_width": 0.4, "level": 0.7},
  "filter": {"cutoff": 900, "resonance": 1.3, "envelope_amount": 2.2, "keytrack": 0.5},
  "amp": {"attack": 0.004, "decay": 0.32, "sustain": 0.0, "release": 0.25},
  "filter_env": {"attack": 0.001, "decay": 0.22, "sustain": 0.0},
  "output": {"volume": 5.8},
  "voice": {"drift": 3, "pan_spread": 0.5},
  "fx": {"delay": {"mix": 0.22, "feedback": 0.4, "tone": 2500, "sync": "1/8d"}, "reverb": {"mix": 0.2, "decay": 0.75}},
  "mlfo2": {"sync": "1/4", "waveform": "saw"},
  "route2": {"source": "mlfo2", "destination": "output.volume", "amount": 0.07}
}
