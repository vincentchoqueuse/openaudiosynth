    },
    {
      "patch": "patches/ambient_air.json",
      "step": 4,
      "notes": "C4 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _",
      "gain_db": -16,
      "reverb_send": 0.4
