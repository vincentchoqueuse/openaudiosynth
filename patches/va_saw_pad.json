{
  "version": 2,
  "engine": "va",
  "name": "va_saw_pad",
  "description": "Two saws with three desynchronized per-voice detune LFOs (osc 2, osc 1, whole voice) in irrational rate ratios; a very slow LFO 1 speeds some up while slowing others and swells their depth (LFO of LFO). Slow swell, soft low-pass.",
  "osc1": {"waveform": "saw"},
  "osc2": {"waveform": "saw", "detune": 0, "level": 1.0},
  "filter": {"cutoff": 850, "resonance": 1.3, "envelope_amount": 1.0, "keytrack": 0.4, "velocity": 0},
  "amp": {"attack": 2.5, "decay": 2.0, "sustain": 1.0, "release": 4.0, "velocity": 0.2},
  "filter_env": {"attack": 3.0, "decay": 6.0, "sustain": 0.5, "release": 4.0},
  "lfo": {"rate": 0.045, "waveform": "tri", "to_pitch": 0, "to_cutoff": 0.6},
  "output": {"volume": -1},
  "voice": {"drift": 8, "pan_spread": 1.0},
  "motion": {
    "detune1": {"rate": 0.17, "depth": 16},
    "spread": 1.0,
    "meta_rate": 1.5,
    "meta_depth": 0.7,
    "detune2": {"rate": 0.13, "depth": 11},
    "detune3": {"rate": 0.04, "depth": 5}
  }
}
