# app_cm4.cmake — adds the screen application to CubeMX's M4 project (included from CM4/CMakeLists.txt):
# ST's board support for the display, the SDRAM and the touch panel, the preset table shared with the M7,
# app/m4 (its renderer gfx.c and the fonts generated by tools/gen_font.py), and the network: the HAL's
# Ethernet with the LAN8742 PHY driver, the board link and the small UDP stack of midi/ (net.c).
set(H745_APP ${CMAKE_CURRENT_LIST_DIR})
set(H745_DRIVERS ${CMAKE_CURRENT_SOURCE_DIR}/../Drivers) # same spelling as mx-generated.cmake (no duplicates)
set(BSP ${H745_DRIVERS}/BSP/STM32H745I-DISCO)
set(HAL ${H745_DRIVERS}/STM32H7xx_HAL_Driver/Src)
set(COMP ${H745_DRIVERS}/BSP/Components)

# HAL modules the BSP needs (TIM: the backlight PWM): enabled here when the CubeMX configuration does not use the peripheral itself
# (stm32h7xx_hal_conf.h then leaves them commented out). Their sources are added in any case.
file(READ ${CMAKE_CURRENT_SOURCE_DIR}/Core/Inc/stm32h7xx_hal_conf.h H745_M4_HALCONF)
foreach(mod LTDC DMA2D SDRAM I2C MDMA TIM ETH)
  if(NOT H745_M4_HALCONF MATCHES "\n#define HAL_${mod}_MODULE_ENABLED")
    list(APPEND H745_M4_HAL_DEFINES HAL_${mod}_MODULE_ENABLED)
  endif()
endforeach()
target_compile_definitions(stm32cubemx INTERFACE ${H745_M4_HAL_DEFINES})

add_library(h745_bsp_m4 STATIC
    ${BSP}/stm32h745i_discovery_lcd.c
    ${BSP}/stm32h745i_discovery_sdram.c
    ${BSP}/stm32h745i_discovery_ts.c
    ${BSP}/stm32h745i_discovery_bus.c
    ${COMP}/mt48lc4m32b2/mt48lc4m32b2.c
    ${COMP}/ft5336/ft5336.c
    ${COMP}/ft5336/ft5336_reg.c
    ${COMP}/gt911/gt911.c
    ${COMP}/gt911/gt911_reg.c
    ${HAL}/stm32h7xx_hal_ltdc.c
    ${HAL}/stm32h7xx_hal_ltdc_ex.c
    ${HAL}/stm32h7xx_hal_dma2d.c
    ${HAL}/stm32h7xx_hal_sdram.c
    ${HAL}/stm32h7xx_ll_fmc.c
    ${HAL}/stm32h7xx_hal_i2c.c
    ${HAL}/stm32h7xx_hal_i2c_ex.c
    ${HAL}/stm32h7xx_hal_mdma.c
    ${HAL}/stm32h7xx_hal_tim.c
    ${HAL}/stm32h7xx_hal_tim_ex.c
    ${HAL}/stm32h7xx_hal_eth.c
    ${HAL}/stm32h7xx_hal_eth_ex.c
    ${COMP}/lan8742/lan8742.c
)
target_include_directories(h745_bsp_m4 PUBLIC ${H745_APP} ${H745_APP}/m4 ${BSP} ${COMP}/Common ${COMP}/lan8742)
target_link_libraries(h745_bsp_m4 PUBLIC stm32cubemx)
target_compile_options(h745_bsp_m4 PRIVATE -O2)

target_sources(${CMAKE_PROJECT_NAME} PRIVATE ${H745_APP}/m4/app_m4.c ${H745_APP}/m4/gfx.c ${H745_APP}/m4/fonts_gen.c
    ${H745_APP}/m4/scope_view.c ${CMAKE_CURRENT_SOURCE_DIR}/../../../dsp/core/fft.c
    ${CMAKE_CURRENT_SOURCE_DIR}/../../../dsp/core/sin_table.c
    ${CMAKE_CURRENT_SOURCE_DIR}/../../../dsp/core/kit.c
    ${H745_APP}/presets_gen.c ${H745_APP}/m4/net.c
    ${CMAKE_CURRENT_SOURCE_DIR}/../../../midi/link.c ${CMAKE_CURRENT_SOURCE_DIR}/../../../midi/udpip.c)
set_source_files_properties(${H745_APP}/m4/gfx.c ${H745_APP}/m4/scope_view.c ${H745_APP}/m4/net.c
    ${CMAKE_CURRENT_SOURCE_DIR}/../../../midi/link.c ${CMAKE_CURRENT_SOURCE_DIR}/../../../midi/udpip.c PROPERTIES COMPILE_OPTIONS "-O2")
target_include_directories(${CMAKE_PROJECT_NAME} PRIVATE ${H745_APP} ${H745_APP}/m4
    ${CMAKE_CURRENT_SOURCE_DIR}/../../../dsp ${CMAKE_CURRENT_SOURCE_DIR}/../../../midi)
target_link_libraries(${CMAKE_PROJECT_NAME} h745_bsp_m4)

