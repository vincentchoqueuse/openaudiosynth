{
  "version": 2,
  "engine": "mono",
  "name": "mono_d_overload",
  "description": "The feedback trick: the output sent back into the mixer through the external input. Three sawtooths, the mixer already driven, feedback up: the bass thickens, compresses and growls, and the filter contour snarls on each note.",
  "osc1": {"octave": "16", "waveform": "saw", "level": 0.9},
  "osc2": {"octave": "16", "waveform": "saw", "detune": 0.1, "level": 0.9},
  "osc3": {"octave": "32", "waveform": "square", "detune": -0.06, "level": 0.8},
  "filter": {"drive": 0.6, "cutoff": 480, "resonance": 0.35, "envelope_amount": 3.0, "keytrack": 0.33},
  "filter_env": {"attack": 0.001, "decay": 0.35, "sustain": 0.3},
  "amp": {"attack": 0.001, "decay": 0.4, "sustain": 0.85, "velocity": 0.4},
  "env": {"release_switch": "off"},
  "output": {"volume": 4},
  "voice": {"bend_range": 7, "priority": "low"},
  "mixer": {"feedback": 0.5},
  "master": {"level": 4}
}
