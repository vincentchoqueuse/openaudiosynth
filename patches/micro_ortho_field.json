    "lock": "1/16",
    "space": "hard",
    "space_delay": 11,
    "ortho": {"amount": 0.42, "mode": "stepped"},
    "pulse1": {"mode": "sync", "div": "1/16", "steps": 16, "edge": 0.0005, "pattern": 46774, "open": 3},
    "pulse2": {"mode": "sync", "div": "1/16", "steps": 16, "edge": 0.0005, "pattern": 257, "open": 32}
  },
  "amp": {"attack": 0.0005, "decay": 0.2, "sustain": 0.5},
  "output": {"volume": 12.6},
  "tempo": {"bpm": 120},
  "macros": [
    {"name": "Sine to noise", "value": 0.42, "targets": [{"param": "micro.ortho.amount", "from": 0.0, "to": 1.0}]}
  ],
  "audition": {"notes": "A4 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _", "bpm": 120, "step": 0.25}
