    "ratchet_decay": -3,
    "gate_mode": "sync",
    "gate_div": "1/16",
    "gate_pattern": 65535,
    "low_level": -4,
    "low_freq": 48,
    "low_drop": 12,
    "low_drop_time": 0.02,
    "low_decay": 0.35,
    "low_gate": "pattern",
    "low_pattern": 4369,
    "lock": "1/16",
    "space": "alternate",
    "space_delay": 23
  },
  "amp": {"attack": 2e-05, "decay": 0.004},
  "output": {"volume": 17.0},
