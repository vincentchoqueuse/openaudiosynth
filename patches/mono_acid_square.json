{
  "version": 2,
  "engine": "mono",
  "name": "mono_acid_square",
  "description": "Square-wave acid: hollower and woodier, lower cutoff, more drive. On the monosynth: one oscillator into the ladder, a short filter contour, slides only between tied notes (glide_mode legato), accents by velocity.",
  "osc1": {"octave": "8", "waveform": "square", "level": 0.8},
  "osc2": {"level": 0},
  "osc3": {"level": 0},
  "filter": {"drive": 0.6, "cutoff": 1144, "resonance": 0.7, "envelope_amount": 4.0, "keytrack": 0},
  "filter_env": {"attack": 0.002, "decay": 0.35, "sustain": 0},
  "amp": {"attack": 0.002, "decay": 2.0, "sustain": 0.7, "velocity": 0.8},
  "voice": {"glide": 0.06, "mode": "legato", "drift": 1, "glide_mode": "legato"},
  "output": {"volume": 8.5},
  "master": {"saturation": {"mode": "soft", "drive": 9.6, "tone": 5500}}
}
